      "source": [
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from scipy import stats"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 4,
      "id": "s12-003",
      "metadata": {
        "id": "s12-003"
      },
      "outputs": [],
      "source": [
        "# @title Готовая функция plot_dist (выполните ячейку, разбирать код не нужно)\n",
        "def plot_dist(sample, dist, title=None):\n",
        "    \"\"\"Рисует выборку и теоретический закон на одном графике.\n",
        "\n",
        "    sample — массив наблюдений (например, результат dist.rvs(...)),\n",
        "    dist   — «замороженное» распределение, например stats.binom(n=10, p=0.3).\n",
        "    \"\"\"\n",
        "    if not hasattr(dist, \"dist\"):\n",
        "        raise TypeError(\"plot_dist ждёт распределение с параметрами, \"\n",
        "                        \"например stats.binom(n=10, p=0.3), а не stats.binom.\")\n",
        "    sample = np.asarray(sample, dtype=float)\n",
        "    if sample.ndim != 1 or sample.size == 0:\n",
        "        raise ValueError(\"Первый аргумент — непустой одномерный массив наблюдений.\")\n",
        "\n",
        "    fig, ax = plt.subplots(figsize=(8, 4))\n",
        "    lo = min(sample.min(), dist.ppf(0.001))\n",
        "    hi = max(sample.max(), dist.ppf(0.999))\n",
        "    if isinstance(dist.dist, stats.rv_discrete):\n",
        "        values, counts = np.unique(sample, return_counts=True)\n",
        "        ax.bar(values, counts / sample.size, width=0.8, color=\"#1F6BFF\",\n",
        "               alpha=0.35, label=\"частоты в выборке\")\n",
        "        ks = np.arange(np.floor(lo), np.ceil(hi) + 1)\n",
        "        ax.vlines(ks, 0, dist.pmf(ks), color=\"#111827\", lw=1.5)\n",
        "        ax.plot(ks, dist.pmf(ks), \"o\", color=\"#111827\", ms=5, label=\"pmf (теория)\")\n",
        "        ax.set_ylabel(\"вероятность / частота\")\n",
        "    else:\n",
        "        ax.hist(sample, bins=50, density=True, color=\"#1F6BFF\", alpha=0.35,\n",
        "                label=\"гистограмма выборки\")\n",
        "        xs = np.linspace(lo, hi, 400)\n",
        "        ax.plot(xs, dist.pdf(xs), color=\"#111827\", lw=2, label=\"pdf (теория)\")\n",
        "        ax.set_ylabel(\"плотность\")\n",
        "    ax.set_xlabel(\"значение\")\n",
        "    ax.set_title(title or f\"{dist.dist.name}: {sample.size} наблюдений\")\n",
        "    ax.grid(alpha=0.3)\n",
        "    ax.legend()\n",
        "    plt.show()"
      ]
    },
